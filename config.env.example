# Visit Plugin Environment Configuration Template
# Copy this file to config.env and update with your actual values

# Pusher Configuration
PUSHER_APP_ID=your_app_id_here
PUSHER_KEY=your_key_here
PUSHER_SECRET=your_secret_here
PUSHER_CLUSTER=your_cluster_here
PUSHER_USE_TLS=true

# Pusher Channel Configuration
PUSHER_CHANNEL=my-channel
PUSHER_EVENT=my-event

# Plugin Settings
VISIT_PLUGIN_ENABLED=true

# Display / Kiosk Show Mode Settings (&show=true)
ANNOUNCEMENT_TEXT=Selamat Datang di Perpustakaan Pesantren Modern Daarul 'Uluum Lido Bogor — Mari Tingkatkan Minat Baca dan Budaya Literasi Santri!
SHOW_MODE_TOP_VISITOR_LIMIT=5
SHOW_MODE_TOP_VISITOR_PERIOD=month
